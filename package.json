{
  "name": "hexo-site",
  "version": "1.0.0",
  "private": true,
  "description": "Source for Lee's SecLab",
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "rebuild": "hexo clean && hexo generate",
    "server": "hexo server",
    "list:posts": "hexo list post",
    "import:csdn": "node tools/import-csdn-selection.js",
    "knowledge:check": "node tools/sync-encrypted-dictionary.js --check",
    "knowledge:practice-docs": "node tools/generate-practice-markdown.js",
    "knowledge:sync": "node tools/sync-encrypted-dictionary.js --sync",
    "knowledge:test": "node tools/verify-encrypted-dictionary.js",
    "knowledge:update": "pwsh -NoProfile -File tools/update-encrypted-dictionary.ps1",
    "verify:output": "node tools/verify-output.js"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "7.3.0",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-feed": "4.0.0",
    "hexo-generator-index": "3.0.0",
    "hexo-generator-searchdb": "1.5.0",
    "hexo-generator-sitemap": "3.0.1",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-ejs": "2.0.0",
    "hexo-renderer-marked": "6.3.0",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-server": "3.0.0",
    "hexo-theme-redefine": "2.9.0",
    "hexo-wordcount": "6.0.1"
  },
  "devDependencies": {
    "jsdom": "20.0.3",
    "marked": "4.3.0",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  }
}
